# Public site URL used for canonical links, sitemaps, and metadata generation.
NEXT_PUBLIC_SITE_URL=https://maldivestour.guide

# Supabase project URL and anon (publishable) key.
# Safe to expose to the browser — access is governed entirely by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key.
# NEVER prefix this with NEXT_PUBLIC_. Server-only. Bypasses Row Level Security.
# Used exclusively by trusted server-side code (see src/lib/supabase/admin.ts) —
# never imported into a Client Component or exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Booking confirmation/alert email delivery (see src/lib/bookings/notifications.ts).
# Without these, booking notifications are recorded as 'failed' with the
# reason, never faked as sent — the booking itself still succeeds either way.
RESEND_API_KEY=
# Must be a sender address on a domain verified in your Resend account.
RESEND_FROM_EMAIL=

# Internal booking alerts via Telegram (optional — email alone still works).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
