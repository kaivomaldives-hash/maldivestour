# Copy to deploy/.env on the VPS and fill in. Never commit deploy/.env.

# --- Domains (used by Caddy for HTTPS) ---
SITE_DOMAIN=maldivestour.guide
API_DOMAIN=api.maldivestour.guide
# Test address that works before the main domain is switched over.
PREVIEW_DOMAIN=new.maldivestour.guide
# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=contact@maldivestour.guide

# --- Website settings (same names as on Vercel) ---
NEXT_PUBLIC_SITE_URL=https://maldivestour.guide
# Your self-hosted Supabase address (API_DOMAIN with https://).
NEXT_PUBLIC_SUPABASE_URL=https://api.maldivestour.guide
# ANON_KEY and SERVICE_ROLE_KEY from ~/supabase-project/.env on the server.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Copy these from Vercel -> Project -> Settings -> Environment Variables.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Used only by the repo's own SQL helper scripts (scripts/run-sql-file.mjs).
# Self-hosted Postgres through Supavisor, reachable only from the server:
# postgres://postgres.<POOLER_TENANT_ID>:<POSTGRES_PASSWORD>@127.0.0.1:5432/postgres?sslmode=disable
DATABASE_URL=

# Git branch the server deploys (deploy-app.sh).
DEPLOY_BRANCH=main
